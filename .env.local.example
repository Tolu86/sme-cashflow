# ===== Firebase Web SDK (public; safe to expose) =====
# Get these from: Firebase Console -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Public app URL (used in Paystack callback + email links) =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Firebase Admin SDK (server-side only; NEVER commit) =====
# Generate a service account at:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# The private key is multi-line. Escape newlines as \n, or keep them and it is auto-normalized.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== NVIDIA NIM API (OpenAI-compatible) =====
# Get your key from: https://build.nvidia.com -> API Catalog -> Generate API Key
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# verified working: nvidia/nemotron-3-super-120b-a12b, nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ===== Paystack (subscription payments) =====
# Get your secret key from: https://dashboard.paystack.com/#/settings/developers
# (Use the "Live" secret key in production, "Test" secret key while developing.)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
# Absolute URL of the deployed app (used for the Paystack callback + email links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

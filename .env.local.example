# ==== Copy to .env.local and fill in real values (production key, never commit) ====

# --- Firebase web (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sme-cashflow.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sme-cashflow
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sme-cashflow.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# --- Firebase Admin (server-only) ---
FIREBASE_PROJECT_ID=sme-cashflow
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sme-cashflow.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----

# --- Payments (Paystack) ---
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_TEST_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Firebase Web SDK (public; safe to expose) =====
# Get these from: Firebase Console -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=REAL_VALUE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REAL_VALUE
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REAL_VALUE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REAL_VALUE
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REAL_VALUE
NEXT_PUBLIC_FIREBASE_APP_ID=REAL_VALUE

# ===== Firebase Admin SDK (server-side only; NEVER commit) =====
# Generate a service account at:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=REAL_VALUE
FIREBASE_CLIENT_EMAIL=REAL_VALUE
-----BEGIN PRIVATE KEY-----\\nREAL_VALUE_SCRUBBED\\n-----END PRIVATE KEY-----

# ===== NVIDIA NIM API (OpenAI-compatible) =====
# Key starts with nvapi- ; verified working against integrate.api.nvidia.com
NVIDIA_API_KEY=REAL_VALUE
NVIDIA_BASE_URL=REAL_VALUE
# Models verified with this key: nvidia/nemotron-3-super-120b-a12b, nvidia/nemotron-3.5-lightning-30b-a3b
# (Kimi k2.6/k3 and other providers return 404/410 for this account)
NVIDIA_MODEL=REAL_VALUE
# ===== Paystack (subscription payments) =====
# Secret key from: https://dashboard.paystack.co/#/settings/developers
# Leave empty to run in LOCAL/dev mode (plans applied without a gateway).
PAYSTACK_SECRET_KEY=REAL_VALUE
NEXT_PUBLIC_APP_URL=REAL_VALUE
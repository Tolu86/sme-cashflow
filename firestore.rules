rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    function isMember(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return biz.ownerId == request.auth.uid || biz.members in request.auth.token ? biz.members.hasAny([request.auth.uid]) : false;
    }

    // Users can only read/write their own profile
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Businesses
    match /businesses/{businessId} {
      allow read, create: if ownsBusiness(businessId) || request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if ownsBusiness(businessId);

      // Sub-collections are guarded by business ownership / membership + auth context
      match /{document=**} {
        allow read, write: if signedIn() && (ownsBusiness(businessId) || isMember(businessId));
      }
    }
  }
}
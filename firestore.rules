rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Authentication and business-role helpers
    // ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.ownerId == request.auth.uid;
    }

    function hasActiveMembership(businessId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
        ).data.status == "active";
    }

    function isBusinessUser(businessId) {
      return ownsBusiness(businessId) || hasActiveMembership(businessId);
    }

    function isManagerOrOwner(businessId) {
      return ownsBusiness(businessId)
        || (
          hasActiveMembership(businessId)
          && get(
            /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
          ).data.role == "manager"
        );
    }

    function validMemberData() {
      return request.resource.data.uid == request.resource.data.uid
        && request.resource.data.businessId == request.resource.data.businessId
        && request.resource.data.role in ["manager", "staff"]
        && request.resource.data.status in ["active", "invited", "suspended"];
    }

    function validTransactionBusiness(businessId) {
      return request.resource.data.businessId == businessId;
    }

    // ---------------------------------------------------------
    // Users
    // ---------------------------------------------------------

    match /users/{uid} {
      allow read, write:
        if signedIn()
        && request.auth.uid == uid;
    }

    // ---------------------------------------------------------
    // Businesses
    // ---------------------------------------------------------

    match /businesses/{businessId} {

      // Create business
      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Business details
      allow read:
        if isBusinessUser(businessId);

      // Only the owner can change business-level settings.
      // Billing/subscription fields remain server-controlled.
      allow update:
        if ownsBusiness(businessId)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.planUpdatedAt == resource.data.planUpdatedAt
        && request.resource.data.planSource == resource.data.planSource;

      allow delete:
        if ownsBusiness(businessId);

      // -------------------------------------------------------
      // Team memberships
      // -------------------------------------------------------

      match /members/{uid} {
        allow read:
          if isManagerOrOwner(businessId);

        allow create:
          if isManagerOrOwner(businessId)
          && request.resource.data.uid == uid
          && request.resource.data.businessId == businessId
          && request.resource.data.role in ["manager", "staff"]
          && request.resource.data.status in ["active", "invited", "suspended"];

        allow update:
          if isManagerOrOwner(businessId)
          && request.resource.data.uid == uid
          && request.resource.data.businessId == businessId
          && request.resource.data.role in ["manager", "staff"]
          && request.resource.data.status in ["active", "invited", "suspended"];

        allow delete:
          if isManagerOrOwner(businessId);
      }

      // -------------------------------------------------------
      // Accounts, categories, vendors and recurring rules
      // Owner/manager can manage them.
      // All active business users can read them.
      // -------------------------------------------------------

      match /accounts/{documentId} {
        allow read: if isBusinessUser(businessId);
        allow create, update, delete: if isManagerOrOwner(businessId);
      }

      match /categories/{documentId} {
        allow read: if isBusinessUser(businessId);
        allow create, update, delete: if isManagerOrOwner(businessId);
      }

      match /vendors/{documentId} {
        allow read: if isBusinessUser(businessId);
        allow create, update, delete: if isManagerOrOwner(businessId);
      }

      match /recurring/{documentId} {
        allow read: if isBusinessUser(businessId);
        allow create, update, delete: if isManagerOrOwner(businessId);
      }

      // -------------------------------------------------------
      // Transactions
      //
      // Staff: read + create
      // Manager: read + create + update + delete
      // Owner: full access
      // -------------------------------------------------------

      match /transactions/{documentId} {
        allow read:
          if isBusinessUser(businessId);

        allow create:
          if isBusinessUser(businessId)
          && validTransactionBusiness(businessId);

        allow update, delete:
          if isManagerOrOwner(businessId);
      }

      // Alerts are visible to all active business users.
      // Only owner/manager can directly modify them.
      match /alerts/{documentId} {
        allow read: if isBusinessUser(businessId);
        allow create, update, delete: if isManagerOrOwner(businessId);
      }
    }

    // ---------------------------------------------------------
    // Payment transactions: server-only
    // ---------------------------------------------------------

    match /paymentTransactions/{reference} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Subscriptions: server-only
    // ---------------------------------------------------------

    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Everything else is denied by default.
    // ---------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
